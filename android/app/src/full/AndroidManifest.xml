<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full builds (GitHub Releases / sideload): raw filesystem library
         scanning, including DSD/DSF files on OEMs whose MediaScanner never
         indexes them. The Play flavor omits this permission because Play
         policy requires MediaStore/SAF for media apps; scoped storage stays
         fully functional without it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
</manifest>
